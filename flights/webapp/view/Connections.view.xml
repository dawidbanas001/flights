<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core" controllerName="pl.tauron.db.flights.controller.Connections">
<Page id="connectionsPage" title="{i18n>connectionsTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button id="_IDGenButton4" text="{i18n>showCarriers}" icon="sap-icon://flight" press=".onShowCarriers"/>
        </headerContent>
<content>
            <Table id="connectionTable"
                core:require="{ Time: 'sap/ui/model/odata/type/Time' }"
                growing="true"
                growingThreshold="15"
                growingScrollToLoad="true"
                updateFinished=".onUpdateFinished"
                items="{
                    path: '/Connection',
                    sorter: { path: 'CarrierName', group: true },
                    parameters: { select: 'CarrierId,CarrierName,ConnectionId,AirportFromId,AirportToId,DepartureTime,Distance,DistanceUnit' }
                }">
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar2">
                        <Title id="_IDGenTitle2" text="{viewList>/title}"/>
                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                        <SearchField id="_IDGenSearchField" width="15rem" search=".onSearch" placeholder="{i18n>searchPlaceholder}"/>
                        <Button id="_IDGenButton5" icon="sap-icon://sort" tooltip="{i18n>sortByDistance}" press=".onSort"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn"><Text id="_IDGenText13" text="{i18n>connection}"/></Column>
                    <Column id="_IDGenColumn6"><Text id="_IDGenText14" text="{i18n>route}"/></Column>
                    <Column id="_IDGenColumn7" minScreenWidth="Tablet" demandPopin="true"><Text id="_IDGenText15" text="{i18n>departure}"/></Column>
                    <Column id="_IDGenColumn8" hAlign="End"><Text id="_IDGenText16" text="{i18n>distance}"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem1" type="Navigation" press=".onPress">
                        <cells>
                            <ObjectIdentifier id="_IDGenObjectIdentifier3" title="{CarrierName}" text="{CarrierId} {ConnectionId}"/>
                            <Text id="_IDGenText17" text="{AirportFromId} → {AirportToId}"/>
                            <Text id="_IDGenText18" text="{ path: 'DepartureTime', type: 'Time' }"/>
                            <ObjectNumber id="_IDGenObjectNumber2" number="{Distance}" unit="{DistanceUnit}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

    </Page>

</mvc:View>