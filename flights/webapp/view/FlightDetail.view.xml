<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core" controllerName="pl.tauron.db.flights.controller.FlightDetail">
<Page id="flightPage" title="{i18n>flightTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <ObjectHeader id="flightHeader"
            core:require="{ Float: 'sap/ui/model/type/Float' }"
            responsive="true"
            title="{carriers>from} → {carriers>to}"
            number="{ path: 'carriers>price', type: 'Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }"
            numberUnit="{carriers>currency}">
            <attributes>
                <ObjectAttribute id="_IDGenObjectAttribute1" title="{i18n>carrier}" text="{carriers>carrierName} ({carriers>carrierId})"/>
                <ObjectAttribute id="_IDGenObjectAttribute2" title="{i18n>connection}" text="{carriers>connId}"/>
            </attributes>
        </ObjectHeader>
        <form:SimpleForm id="flightForm" editable="false" layout="ResponsiveGridLayout" title="{i18n>flightDetails}">
            <Label id="_IDGenLabel3" text="{i18n>departure}"/>
            <Text id="_IDGenText8" text="{carriers>from}, {carriers>depTime}"/>
            <Label id="_IDGenLabel4" text="{i18n>arrival}"/>
            <Text id="_IDGenText9" text="{carriers>to}, {carriers>arrTime}"/>
            <Label id="_IDGenLabel5" text="{i18n>duration}"/>
            <Text id="_IDGenText10" text="{carriers>duration}"/>
            <Label id="_IDGenLabel6" text="{i18n>distance}"/>
            <Text id="_IDGenText11" text="{carriers>distance} km"/>
            <Label id="_IDGenLabel7" text="{i18n>aircraft}"/>
            <Text id="_IDGenText12" text="{carriers>aircraft}"/>
        </form:SimpleForm>
    </Page>

</mvc:View>