<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core" controllerName="pl.tauron.db.flights.controller.Detail">
    <Page id="detailPage"   
        title="{CarrierId} {ConnectionId}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        core:require="{ Time: 'sap/ui/model/odata/type/Time', DateTime: 'sap/ui/model/odata/type/DateTime' }">
<content>
            <ObjectHeader id="connectionHeader"
                responsive="true"
                title="{CarrierName}"
                number="{Distance}"
                numberUnit="{DistanceUnit}">
                <attributes>
                    <ObjectAttribute id="_IDGenObjectAttribute" title="{i18n>route}" text="{AirportFromId} → {AirportToId}"/>
                    <ObjectAttribute id="_IDGenObjectAttribute3" title="{i18n>departure}" text="{ path: 'DepartureTime', type: 'Time' }"/>
                </attributes>
            </ObjectHeader>
            <Table id="flightTableDetail"
                headerText="{i18n>flights}"
                items="{ path: 'to_Flight', sorter: { path: 'FlightDate' } }">
                <columns>
                    <Column id="_IDGenColumn10"><Text id="_IDGenText19" text="{i18n>flightDate}"/></Column>
                    <Column id="_IDGenColumn11" hAlign="End"><Text id="_IDGenText20" text="{i18n>price}"/></Column>
                    <Column id="_IDGenColumn13" minScreenWidth="Tablet" demandPopin="true"><Text id="_IDGenText21" text="{i18n>occupancy}"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem2">
                        <cells>
                            <Text id="_IDGenText23" text="{ path: 'FlightDate', type: 'DateTime', constraints: { displayFormat: 'Date' } }"/>
                            <ObjectNumber id="_IDGenObjectNumber3" number="{Price}" unit="{CurrencyCode}"/>
                            <ProgressIndicator id="_IDGenProgressIndicator"
                                percentValue="{= ${SeatsMax} > 0 ? ${SeatsOccupied} / ${SeatsMax} * 100 : 0 }"
                                displayValue="{SeatsOccupied} / {SeatsMax}"
                                state="{= ${SeatsOccupied} >= ${SeatsMax} ? 'Error' : 'Success' }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        
    </Page>

</mvc:View>